<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Een bibliotheek en geen eigen exe meer: ImageFunn is een onderdeel van
         Jabasoft en draait in diens venster (zie Jabasoft.App/MainWindow).
         Er is dus ook geen App.xaml meer - de resources (thema, schuifbalk,
         ververstijd) komen uit die van Jabasoft. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Het versienummer van deze applicatie, los van dat van de rest van de
         familie: elke app telt zijn eigen wijzigingen. Elke wijziging:
         laatste cijfer +1. -->
    <Version>0.1.0.44</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gedeelde styling/theming: dezelfde {DynamicResource}-tokens als de
         rest van de familie, zodat ImageFunn er hetzelfde uitziet zonder
         hier ooit een kleur hard te coderen. -->
    <ProjectReference Include="..\..\Jabasoft.Stylebook\Stylebook.Components\Stylebook.Components.csproj" />

    <!-- De gedeelde bouwstenen: AppHandover (single-instance), de AI-broker,
         gezondheidsbewaking en logging. -->
    <ProjectReference Include="..\..\Jabasoft.Base\Jabasoft.Base.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- De projectmap, vastgelegd bij het bouwen. Wie vanuit hier een map
         naast het project zoekt (een Python-service), kan niet meer uitgaan
         van de map van de exe: dat is die van Jabasoft, in een andere repo. -->
    <AssemblyMetadata Include="ProjectMap" Value="$(MSBuildProjectDirectory)" />
  </ItemGroup>

</Project>
