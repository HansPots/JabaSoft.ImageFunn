<Application x:Class="ImageFunn.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:ImageFunn.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Gedeelde typografie/styles die elke echte app meeneemt -
                     zie Stylebook.Components/Styles/Theme.xaml. -->
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <!-- LCARS is het startthema van de familie. -->
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Schuifbalk in de huisstijl - gelijk aan Jabasoft en AI
                Studio. Staat hier en niet in de gedeelde Styles/Controls.xaml:
                dit is een IMPLICIETE stijl, dus hij geldt voor elke
                ScrollBar die hem ziet (zoals in Controls/Activity). In de
                gedeelde bibliotheek zou hij ook de Stylebook-tool omzetten,
                en die houdt zijn eigen vaste look.
            -->
            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Border CornerRadius="{DynamicResource RadiusSmall}"
                                        Background="{DynamicResource SurfaceBrush}"
                                        Opacity="0.6"
                                        Margin="2,0,6,0" />
                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="Transparent" />
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="Duim"
                                                            CornerRadius="{DynamicResource RadiusSmall}"
                                                            Background="{DynamicResource BorderBrush}"
                                                            Margin="2,0,6,0" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Duim" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Height" Value="10" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <sys:Double x:Key="RefreshIntervalSeconds">5</sys:Double>
        </ResourceDictionary>
    </Application.Resources>
</Application>
