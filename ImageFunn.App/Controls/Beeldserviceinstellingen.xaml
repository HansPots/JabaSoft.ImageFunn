<UserControl x:Class="ImageFunn.App.Controls.Beeldserviceinstellingen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="900">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Instellingenkaart BEELDSERVICE: wat er eerst alleen met
        omgevingsvariabelen (IMAGEFUNN_MODEL, IMAGEFUNN_ONTLAAD_NA) in te
        stellen was. Staat op het ene instellingenscherm van Jabasoft, onder
        het kopje ImageFunn - zelfde kaartvorm als de kaarten daar.

        De service leest dit bij het STARTEN; een draaiende service houdt
        zijn keuze tot hij stopt. Dat zegt de uitleg ook.
    -->
    <Border MinWidth="480" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="{DynamicResource RegionBorderThickness}"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Top">
        <StackPanel Margin="20,16">
            <TextBlock Text="Beeldservice" FontSize="{DynamicResource FontSizeTitle}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Text01Brush}" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"
                       Text="Geldt vanaf de volgende start van de beeldservice. Die stopt zichzelf na de ingestelde tijd zonder opdracht en start bij de volgende opdracht vanzelf weer." />

            <TextBlock Text="Standaard beeldmodel" Margin="0,14,0,4"
                       Foreground="{DynamicResource Text01Brush}" FontSize="{DynamicResource FontSizeSmall}" />
            <ComboBox x:Name="ModelKeuze" Width="420" HorizontalAlignment="Left"
                      AutomationProperties.Name="Standaard beeldmodel"
                      SelectionChanged="Instelling_Gewijzigd" />

            <TextBlock Text="Modellen loslaten en de service stoppen na" Margin="0,14,0,4"
                       Foreground="{DynamicResource Text01Brush}" FontSize="{DynamicResource FontSizeSmall}" />
            <ComboBox x:Name="OntladenKeuze" Width="420" HorizontalAlignment="Left"
                      AutomationProperties.Name="Beeldservice stoppen na"
                      SelectionChanged="Instelling_Gewijzigd" />
        </StackPanel>
    </Border>
</UserControl>
