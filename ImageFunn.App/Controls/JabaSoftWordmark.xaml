<UserControl x:Class="ImageFunn.App.Controls.JabaSoftWordmark"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ImageFunn.App.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             FontFamily="{StaticResource LogoFontFamily}">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Algemeen: het "JabaSoft the Application"-beeldmerk, op een balk in
        de achtergrondkleur. Zie Jabasoft/LocalAiStudio's eigen kopie voor
        de volledige toelichting op de maatvoering - dit is dezelfde
        opbouw, alleen niet gedeeld (elke app heeft zijn eigen kopie).
    -->
    <Border Background="{DynamicResource BackgroundBrush}"
            Padding="24,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top">
        <Grid Margin="0,-16,0,-7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*"/>
                <RowDefinition Height="1*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                       Text="Jaba"
                       FontWeight="Bold"
                       FontSize="48"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Bottom"/>

            <TextBlock Grid.Row="0"
                       Text="Soft"
                       FontWeight="Bold"
                       FontSize="36"
                       Foreground="{DynamicResource Text01Brush}"
                       VerticalAlignment="Top"
                       Margin="101,4,1,0" Grid.RowSpan="2" Grid.ColumnSpan="2"/>

            <!-- Geen vaste tekst meer: de applicatie zet straks
                 ApplicationName (zie JabaSoftWordmark.xaml.cs). Staat die
                 niet gezet, dan blijft "the Application" staan. -->
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding ApplicationName, RelativeSource={RelativeSource AncestorType={x:Type controls:JabaSoftWordmark}}}"
                       FontSize="12"
                       Foreground="{DynamicResource TextMutedBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Bottom"
                       Margin="0,0,0,8"/>
        </Grid>
    </Border>

</UserControl>
