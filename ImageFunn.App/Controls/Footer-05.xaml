<UserControl x:Class="ImageFunn.App.Controls.Footer05"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="436" Height="24">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        AI-WACHTRIJ: wat er aan vragen bij de AI-broker loopt en wacht, uit
        alle onderdelen samen. De tekst telt ze, het balkje toont de lopende
        vraag; klik voor het lijstje met Annuleren (zie Footer-05.xaml.cs).
    -->
    <!--
        Footerpil 5 van 5: PROCESSING. Laatste pil, in het accentkleur en breder dan de andere: hij staat rechts en loopt tot de rand van de footer.

        Toont hoe ver de AI-server is met het INLEZEN van de prompt (zie
        Jabasoft.Base.AiBroker.PromptProgressTicker en ChatStreamChunk.PromptProgress) -
        de balk staat leeg (spoor, geen waarde) zolang er geen vraag loopt bij
        een van de familie-apps, of zodra de actieve server dit niet
        doorgeeft (Ollama). ImageFunn praat zelf nog niet met een model, dus
        deze pil blijft voorlopig leeg - het mechanisme staat er wel, net
        als in AI Studio.
    -->
    <Border x:Name="Pil" Height="24" CornerRadius="{DynamicResource RadiusLarge}"
            Cursor="Hand" MouseLeftButtonUp="Pil_Klik" ToolTip="Klik voor de wachtrij van de AI-broker"
            Background="{DynamicResource AccentBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="AI-WACHTRIJ"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource BackgroundBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="ValueText" Text="" Margin="8,0,0,0"
                       FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BackgroundBrush}" VerticalAlignment="Center" />

            <Grid Grid.Column="2" Height="4" Margin="12,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BarFill" Width="0*" />
                    <ColumnDefinition x:Name="BarRest" Width="100*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" CornerRadius="{DynamicResource RadiusSmall}"
                        Background="{DynamicResource BackgroundBrush}" Opacity="0.25" />
                <Border Grid.Column="0" CornerRadius="{DynamicResource RadiusSmall}"
                        Background="{DynamicResource BackgroundBrush}" />
            </Grid>

            <!-- Het lijstje met elke vraag apart en een knop om hem te
                 annuleren - opent boven de pil als je erop klikt, en gaat
                 dicht als je ergens anders klikt. Gevuld in code-behind. -->
            <Popup x:Name="Lijstje" PlacementTarget="{Binding ElementName=Pil}" Placement="Top"
                   StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
                <Border MinWidth="380" MaxWidth="560" Padding="16,12"
                        CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="2"
                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource AccentBrush}">
                    <StackPanel>
                        <TextBlock Text="AI-WACHTRIJ" FontWeight="SemiBold"
                                   FontSize="{DynamicResource FontSizeSmall}" Foreground="{DynamicResource AccentBrush}" />
                        <StackPanel x:Name="Regels" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Border>

</UserControl>
