<UserControl x:Class="ImageFunn.App.Controls.Footer05"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Width="436" Height="24">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Footerpil 5 van 5: PROCESSING. Laatste pil, in het accentkleur en breder dan de andere: hij staat rechts en loopt tot de rand van de footer.

        Toont hoe ver de AI-server is met het INLEZEN van de prompt (zie
        Jabasoft.Base.AiBroker.PromptProgressTicker en ChatStreamChunk.PromptProgress) -
        de balk staat leeg (spoor, geen waarde) zolang er geen vraag loopt bij
        een van de familie-apps, of zodra de actieve server dit niet
        doorgeeft (Ollama). ImageFunn praat zelf nog niet met een model, dus
        deze pil blijft voorlopig leeg - het mechanisme staat er wel, net
        als in AI Studio.
    -->
    <Border Height="24" CornerRadius="{DynamicResource RadiusLarge}"
            Background="{DynamicResource AccentBrush}"
            HorizontalAlignment="Stretch" VerticalAlignment="Center">
        <Grid Margin="12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="PROCESSING"
                       FontSize="{DynamicResource FontSizeSmall}"
                       Foreground="{DynamicResource BackgroundBrush}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" x:Name="ValueText" Text="" Margin="8,0,0,0"
                       FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold"
                       Foreground="{DynamicResource BackgroundBrush}" VerticalAlignment="Center" />

            <Grid Grid.Column="2" Height="4" Margin="12,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BarFill" Width="0*" />
                    <ColumnDefinition x:Name="BarRest" Width="100*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" CornerRadius="{DynamicResource RadiusSmall}"
                        Background="{DynamicResource BackgroundBrush}" Opacity="0.25" />
                <Border Grid.Column="0" CornerRadius="{DynamicResource RadiusSmall}"
                        Background="{DynamicResource BackgroundBrush}" />
            </Grid>
        </Grid>
    </Border>

</UserControl>
