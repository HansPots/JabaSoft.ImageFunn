<UserControl x:Class="ImageFunn.App.Controls.Infoblok2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Height="166" Width="450">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Header-regio component: variant van Infoblok met een apart
        gekleurde titelbalk boven de body-tekst - vrije plek in de header,
        nog geen eigen inhoud toegewezen. Kleuren via DynamicResource,
        volgt dus het actieve thema.
    -->
    <Border Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="{DynamicResource RegionBorderThickness}"
            CornerRadius="{DynamicResource RadiusMedium}"
            HorizontalAlignment="Stretch">
        <StackPanel>
            <!-- Hoekstraal 5, niet 6: de buitenrand heeft straal 6 met een
                 rand van 1px, dus de BINNENkant van die rand loopt op 6-1=5.
                 Met 6 loopt de bocht van deze balk niet mee met de bocht van
                 de rand en zie je in beide bovenhoeken een kiertje
                 SurfaceBrush tussen de rand en het blok. -->
            <Border Background="{DynamicResource BorderBrush}" CornerRadius="{DynamicResource RegionBorderInnerRadius}" Height="24" Padding="8,0">
                <TextBlock Text="InfoBlok" FontSize="18" Foreground="{DynamicResource Text01Brush}" VerticalAlignment="Center" TextWrapping="Wrap" Height="24" HorizontalAlignment="Left" TextAlignment="Center" />
            </Border>
            <StackPanel Margin="8">
                <TextBlock Text="Dit is een informatieblok voor de header." Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Height="116" />
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
