<UserControl x:Class="ImageFunn.App.Controls.WindowControlButtons"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!-- Algemeen: rij van drie vensterknopjes (minimaliseren/herstellen/
         sluiten). Ze bedienen het venster waar dit component in zit -
         zie de code-behind; dat venster wordt niet doorgegeven maar
         opgezocht, zodat dit component overal inzetbaar blijft.

         In deze applicatie VERVANGEN ze de titelbalk van Windows (MainWindow
         staat op WindowStyle="None"), dus als deze drie het niet doen
         is het venster niet meer te sluiten. -->
    <StackPanel Orientation="Horizontal">

        <Button x:Name="MinimizeButton" Click="Minimize_Click"
                AutomationProperties.AutomationId="VensterMinimaliseren"
                ToolTip="Minimaliseren"
                Width="34" Height="32" Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource TextPrimaryBrush}"
                FontSize="{DynamicResource FontSizeTitle}"
                Content="&#8212;">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Herstellen: het vierkantje is getekend in plaats van het teken
             U+25A1. Dat teken zit niet in het app-lettertype; Windows valt dan
             terug op een lettertype waarin het maar 8x8 px wordt (gemeten bij
             FontSizeTitle), terwijl het kruisje 12x13 is. Dit kader is even
             groot als het kruisje en volgt de Foreground van de knop. -->
        <Button x:Name="RestoreButton" Click="Restore_Click"
                AutomationProperties.AutomationId="VensterHerstellen"
                ToolTip="Maximaliseren"
                Width="34" Height="32" Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource TextPrimaryBrush}">
            <!-- Twee tekeningen op dezelfde plek: een enkel kader zolang
                 het venster op zijn gewone maat staat, twee kadertjes
                 over elkaar als het gemaximaliseerd is. De code-behind
                 wisselt ze om bij elke toestandswissel, zodat het knopje
                 laat zien wat het GAAT doen in plaats van altijd
                 hetzelfde te tonen. -->
            <Grid Width="12" Height="12">
                <Border x:Name="MaximizeGlyph"
                        Width="12" Height="12" BorderThickness="2"
                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <Grid x:Name="RestoreGlyph" Visibility="Collapsed">
                    <Border Width="9" Height="9" BorderThickness="2"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <Border Width="9" Height="9" BorderThickness="2"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Background="{DynamicResource BackgroundBrush}"
                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Grid>
            </Grid>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Button x:Name="CloseButton" Click="Close_Click"
                AutomationProperties.AutomationId="VensterSluiten"
                ToolTip="Sluiten"
                Width="34" Height="32" Background="Transparent" BorderThickness="0"
                Foreground="{DynamicResource TextPrimaryBrush}"
                FontSize="{DynamicResource FontSizeTitle}"
                Content="&#10005;">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </StackPanel>

</UserControl>
