<UserControl x:Class="ImageFunn.App.Controls.RefreshButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theming="clr-namespace:Stylebook.Components.Theming;assembly=Stylebook.Components"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype) - deze class library heeft
         zelf geen App.xaml die dat normaal doet. mc:Ignorable="d" zorgt
         dat dit bij het echt compileren/draaien volledig wegvalt. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Verversknop voor de Actie-rail. 48 breed = de volle breedte van de
        Actie-basis, dus hij sluit strak aan tegen de linkerrand van die
        rail: links vlak, rechts rond met een straal van 24.

        Het pictogram is IconRefresh uit Typography.xaml, in het
        icoonlettertype van het thema - dezelfde bron als de iconen in
        Navigatiemenu, en dus scherp op elke maat.
    -->
    <Button x:Name="RefreshAction" Width="48" Height="48" HorizontalAlignment="Left" VerticalAlignment="Top"
            AutomationProperties.Name="Verversen"
            Foreground="{DynamicResource BackgroundBrush}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Bd"
                        theming:CornerRadiusParts.TopLeft="0"
                        theming:CornerRadiusParts.TopRight="{DynamicResource RadiusXXLarge}"
                        theming:CornerRadiusParts.BottomRight="{DynamicResource RadiusXXLarge}"
                        theming:CornerRadiusParts.BottomLeft="0"
                        Background="{DynamicResource BorderBrush}">
                    <TextBlock Text="{DynamicResource IconRefresh}"
                               FontFamily="{DynamicResource IconFontFamily}"
                               FontSize="28"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>

</UserControl>
