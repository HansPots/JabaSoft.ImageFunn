<UserControl x:Class="ImageFunn.App.Regios.Inhoud.BeeldNaarVideo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1616" d:DesignHeight="846">

    <!-- Design-time-only: zie BeeldNaarTekst.xaml. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Inhoud-regio component: het scherm waar "Beeld naar video" in het
        menu naartoe schakelt. Links het beeld dat bewogen moet worden en
        hoe, rechts de gemaakte video (herhalend afgespeeld). De video
        wordt gemaakt door LTX-Video in de lokale beeldservice (zie
        ImageFunn.Image/service.py); dat duurt enkele minuten, dus dit
        scherm peilt de voortgang net als Tekst naar beeld.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Beeld naar video" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <!-- Links: bronbeeld en instellingen. -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Bronbeeld: klik om te kiezen, of sleep een bestand erop. -->
                <Border x:Name="DropZone" Grid.Row="0" AllowDrop="True" Drop="DropZone_Drop" Cursor="Hand"
                        MouseLeftButtonUp="DropZone_Klik"
                        Background="{DynamicResource BackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMedium}">
                    <Grid>
                        <Image x:Name="Bron" Stretch="Uniform" Margin="6" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock x:Name="DropTekst" Text="Klik of sleep het beeld hierheen dat moet bewegen"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}" />
                    </Grid>
                </Border>

                <TextBlock Grid.Row="1" Text="Hoe moet het bewegen? (optioneel)" Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource FontSizeSmall}" Margin="0,14,0,6" />

                <Border Grid.Row="2" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="1"
                        Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                    <TextBox x:Name="PromptBox"
                             Background="Transparent" BorderThickness="0" Padding="10,8"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             FontSize="{DynamicResource FontSizeSmall}"
                             ToolTip="Bijvoorbeeld: de heks vliegt langzaam naar rechts, de wolken drijven voorbij en de camera zoomt rustig in" />
                </Border>

                <StackPanel Grid.Row="3">
                    <ComboBox x:Name="ModelKeuze" SelectedIndex="0" Margin="0,14,0,0"
                              ToolTip="LTX is snel maar beweegt vooral de camera. Wan 2.2 beweegt personen en dingen echter, maar is veel trager en de eerste keer wordt er ±30 GB aan model geladen.">
                        <ComboBoxItem Content="Videomodel: LTX-Video (snel)" Tag="ltx" />
                        <ComboBoxItem Content="Videomodel: Wan 2.2 (echtere beweging, trager)" Tag="wan" />
                    </ComboBox>
                    <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" x:Name="DuurKeuze" SelectedIndex="1">
                        <ComboBoxItem Content="Kort (±2 sec)" Tag="49" />
                        <ComboBoxItem Content="Normaal (±4 sec)" Tag="97" />
                        <ComboBoxItem Content="Lang (±6 sec)" Tag="145" />
                    </ComboBox>
                    <ComboBox Grid.Column="2" x:Name="KwaliteitKeuze" SelectedIndex="1">
                        <ComboBoxItem Content="Snel (klein)" Tag="384x384" />
                        <ComboBoxItem Content="Normaal" Tag="640x480" />
                        <ComboBoxItem Content="Scherp (trager)" Tag="768x512" />
                    </ComboBox>
                </Grid>
                </StackPanel>

                <CheckBox Grid.Row="4" x:Name="VerbeterBox" IsChecked="True" Margin="0,14,0,0"
                          Content="Beweging automatisch vertalen en verbeteren"
                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSizeSmall}"
                          ToolTip="Het videomodel begrijpt alleen Engels. Hiermee schrijft het chatmodel je omschrijving eerst om." />

                <StackPanel Grid.Row="5" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="MaakButton" Content="Maak video" Click="MaakButton_Click"
                            Style="{DynamicResource AccentButtonStyle}" />
                        <Button x:Name="CleanButton" Content="Clean" Click="CleanButton_Click" Margin="10,0,0,0"
                                ToolTip="Clean: je tekst gaat precies zo naar het model. Niet vertaald, niet verbeterd en zonder stijltekst erbij. Schrijf dan zelf in het Engels." Style="{DynamicResource AccentButtonStyle}" />
                    </StackPanel>
                    <ProgressBar x:Name="Voortgang" Height="6" Minimum="0" Maximum="1" Margin="0,10,0,0"
                                 Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource BackgroundBrush}" BorderThickness="0" />
                    <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rechts: de video. -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}">
                <Grid>
                    <MediaElement x:Name="Speler" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"
                                  Margin="8" MediaEnded="Speler_MediaEnded" MediaFailed="Speler_MediaFailed" />
                    <Image x:Name="VoorproefBeeld" Margin="8" Stretch="Uniform" Visibility="Collapsed"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="LegeTekst" Text="Hier verschijnt je video"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                <Button x:Name="OpslaanButton" Content="Opslaan als…" Click="OpslaanButton_Click" IsEnabled="False"
                        Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Eerder gemaakte video's, nieuwste eerst. -->
        <ListBox Grid.Row="2" Grid.ColumnSpan="3" x:Name="Galerij" Margin="0,16,0,0" Height="84"
                 Background="Transparent" BorderThickness="0"
                 Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSizeSmall}"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectionChanged="Galerij_SelectionChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>

</UserControl>
