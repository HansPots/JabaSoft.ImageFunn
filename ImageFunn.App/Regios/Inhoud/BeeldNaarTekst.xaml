<UserControl x:Class="ImageFunn.App.Regios.Inhoud.BeeldNaarTekst"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1616" d:DesignHeight="846">

    <!-- Design-time-only: geeft Visual Studio/Blend's Designer een
         thema-context (kleuren, lettertype). mc:Ignorable="d" laat dit bij
         het echt draaien volledig wegvallen. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Inhoud-regio component: het scherm waar "Beeld naar tekst" in het
        menu naartoe schakelt. Links de afbeelding (kiezen, slepen of
        plakken), rechts wat het beeldmodel erover zegt. Het model zelf
        draait via de AI-broker (zie Ai/Beeldlezer), net als in AI Studio.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Beeld naar tekst" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <!-- Links: de afbeelding en de bediening. -->
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Afbeelding: klik om te kiezen, sleep een bestand erop, of plak met Ctrl+V. -->
            <Border x:Name="DropZone" Grid.Row="0" AllowDrop="True" Drop="DropZone_Drop" Cursor="Hand"
                    MouseLeftButtonUp="DropZone_Klik"
                    Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}">
                <Grid>
                    <Image x:Name="Voorbeeld" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="DropTekst" Text="Klik, sleep een afbeelding hierheen of plak met Ctrl+V"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Margin="0,12,0,0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}" Padding="16,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="DoelKeuze" Grid.Row="0" Grid.Column="0" MinWidth="220" SelectedIndex="0" VerticalAlignment="Center">
                        <ComboBoxItem Content="Beschrijving" />
                        <ComboBoxItem Content="Tekst uitlezen (OCR)" />
                        <ComboBoxItem Content="Prompt voor beeldgenerator" />
                    </ComboBox>

                    <Border Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="1"
                            Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <TextBox x:Name="WensBox"
                                 Background="Transparent" BorderThickness="0" Padding="10,6"
                                 MinHeight="32" VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 FontSize="{DynamicResource FontSizeSmall}"
                                 ToolTip="Optionele extra wens, bijvoorbeeld: let vooral op de kleding" />
                    </Border>

                    <Button Grid.Row="0" Grid.Column="2" x:Name="LeesButton" Content="Lees afbeelding" Click="LeesButton_Click"
                            Margin="10,0,0,0" Style="{DynamicResource AccentButtonStyle}" />

                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" x:Name="StatusText" Margin="0,10,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>

        <!-- Rechts: het antwoord van het model. -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}">
                <TextBox x:Name="ResultaatBox"
                         Background="Transparent" BorderThickness="0" Padding="12"
                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="{DynamicResource FontSizeSmall}"
                         Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>

            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                <Button x:Name="KopieerButton" Content="Kopieer" Click="KopieerButton_Click" IsEnabled="False"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button x:Name="NaarBeeldButton" Content="Maak er een beeld van" Click="NaarBeeldButton_Click" IsEnabled="False"
                        Margin="10,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>

</UserControl>
