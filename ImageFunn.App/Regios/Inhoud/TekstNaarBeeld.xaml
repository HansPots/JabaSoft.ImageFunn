<UserControl x:Class="ImageFunn.App.Regios.Inhoud.TekstNaarBeeld"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1616" d:DesignHeight="846">

    <!-- Design-time-only: zie BeeldNaarTekst.xaml. -->
    <d:UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Theme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Stylebook.Components;component/Styles/Themes/Lcars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </d:UserControl.Resources>

    <!--
        Inhoud-regio component: het scherm waar "Tekst naar beeld" in het
        menu naartoe schakelt. Links de omschrijving en de instellingen,
        rechts het beeld. Stuurt de lokale beeldservice aan (zie
        ImageService/ en ImageFunn.Image/service.py voor de Python-kant).

        Onderaan een galerij van eerder gemaakte beelden. De service werkt
        met polling (zie TekstNaarBeeld.xaml.cs): een beeld kan een halve
        minuut duren, de eerste keer veel langer door het laden van het model.
    -->
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Tekst naar beeld" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <!-- Links: omschrijving en instellingen. -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="{DynamicResource RadiusMedium}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Omschrijving" Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,6" />

                <Border Grid.Row="1" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="1"
                        Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                    <TextBox x:Name="PromptBox"
                             Background="Transparent" BorderThickness="0" Padding="10,8"
                             AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource TextPrimaryBrush}"
                             FontSize="{DynamicResource FontSizeSmall}" />
                </Border>

                <TextBlock Grid.Row="2" Text="Formaat" Foreground="{DynamicResource TextMutedBrush}"
                           FontSize="{DynamicResource FontSizeSmall}" Margin="0,14,0,6" />
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="FormaatKeuze" SelectedIndex="0">
                        <ComboBoxItem Content="Vierkant 1024 × 1024" Tag="1024x1024" />
                        <ComboBoxItem Content="Liggend 1344 × 768" Tag="1344x768" />
                        <ComboBoxItem Content="Staand 768 × 1344" Tag="768x1344" />
                        <ComboBoxItem Content="Klein vierkant 768 × 768 (sneller)" Tag="768x768" />
                    </ComboBox>
                    <ComboBox Grid.Column="2" x:Name="StijlKeuze" SelectedIndex="0" ToolTip="Hoe het beeld eruitziet">
                        <ComboBoxItem Content="Realistisch (foto)" Tag="realistisch" />
                        <ComboBoxItem Content="Filmisch" Tag="filmisch" />
                        <ComboBoxItem Content="Illustratie" Tag="illustratie" />
                        <ComboBoxItem Content="Tekenfilm / animatie" Tag="tekenfilm" />
                        <ComboBoxItem Content="Geen (alleen mijn tekst)" Tag="geen" />
                    </ComboBox>
                </Grid>

                <CheckBox Grid.Row="4" x:Name="VerbeterBox" IsChecked="True" Margin="0,14,0,0"
                          Content="Prompt automatisch vertalen en verbeteren (aanbevolen)"
                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSizeSmall}"
                          ToolTip="Het beeldmodel begrijpt alleen Engels. Hiermee schrijft het chatmodel je omschrijving eerst om." />

                <Grid Grid.Row="5" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Seed" Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"
                               VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Border Grid.Column="1" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="1"
                            Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <TextBox x:Name="SeedBox"
                                 Background="Transparent" BorderThickness="0" Padding="10,6" MinHeight="32"
                                 VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 FontSize="{DynamicResource FontSizeSmall}"
                                 ToolTip="Leeg = willekeurig. Dezelfde omschrijving met dezelfde seed geeft hetzelfde beeld." />
                    </Border>
                </Grid>

                <StackPanel Grid.Row="6" Margin="0,16,0,0">
                    <Button x:Name="GenereerButton" Content="Genereer" Click="GenereerButton_Click"
                            Style="{DynamicResource AccentButtonStyle}" />
                    <ProgressBar x:Name="Voortgang" Height="6" Minimum="0" Maximum="1" Margin="0,10,0,0"
                                 Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}"
                                 Background="{DynamicResource BackgroundBrush}" BorderThickness="0" />
                    <TextBlock x:Name="StatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rechts: het beeld en het bijsturen ervan. -->
        <Grid Grid.Row="1" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}">
                <Grid>
                    <Image x:Name="Resultaat" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                    <!-- Het tekenvlak om een gebied aan te wijzen: ligt precies over het beeld heen (zelfde marge) en is alleen
                         actief als 'Gebied aanwijzen' aanstaat. Het rood is alleen voor jou; het masker wordt apart gemaakt. -->
                    <InkCanvas x:Name="Tekenvlak" Margin="8" Background="Transparent" Visibility="Collapsed" Cursor="Pen" />
                    <TextBlock x:Name="LegeTekst" Text="Hier verschijnt je beeld"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}" />
                </Grid>
            </Border>

            <!-- Bijsturen: het getoonde beeld aanpassen, in plaats van opnieuw beginnen. -->
            <Border x:Name="BijstuurKaart" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusMedium}" Padding="14,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Bijsturen - wat moet er anders aan dit beeld?" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,6" />

                    <Border Grid.Row="1" Grid.Column="0" CornerRadius="{DynamicResource RadiusMedium}" BorderThickness="1"
                            Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <TextBox x:Name="WijzigBox" Background="Transparent" BorderThickness="0" Padding="10,6" MinHeight="34"
                                 VerticalContentAlignment="Center" AcceptsReturn="False"
                                 Foreground="{DynamicResource TextPrimaryBrush}" CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 FontSize="{DynamicResource FontSizeSmall}"
                                 ToolTip="Bijvoorbeeld: de persoon iets groter, of een rode fiets tegen een boom op de achtergrond" />
                    </Border>
                    <Button Grid.Row="1" Grid.Column="1" x:Name="BijstuurButton" Content="Pas toe" Click="BijstuurButton_Click"
                            Margin="10,0,0,0" Style="{DynamicResource AccentButtonStyle}" />

                    <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" x:Name="SterkteTekst" VerticalAlignment="Center" Margin="0,0,10,0" MinWidth="170"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}"
                                   Text="Hoeveel mag er veranderen: 40%" />
                        <Slider Grid.Column="1" x:Name="SterkteSlider" Minimum="10" Maximum="95" Value="40" VerticalAlignment="Center"
                                ValueChanged="SterkteSlider_ValueChanged"
                                ToolTip="Laag: de indeling blijft bijna gelijk. Hoog: meer vrijheid, en nodig om een object toe te voegen." />

                        <WrapPanel Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <CheckBox x:Name="GebiedBox" Content="Gebied aanwijzen" Margin="14,0,10,0" VerticalAlignment="Center"
                                      Checked="GebiedBox_Changed" Unchecked="GebiedBox_Changed"
                                      Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSizeSmall}"
                                      ToolTip="Teken op het beeld waar iets moet veranderen. Alleen dat gebied wordt opnieuw gemaakt, de rest blijft zoals het is." />
                            <StackPanel x:Name="PenseelPaneel" Orientation="Horizontal" Visibility="Collapsed" VerticalAlignment="Center">
                                <TextBlock Text="Penseel" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="{DynamicResource FontSizeSmall}" />
                                <Slider x:Name="PenseelSlider" Minimum="10" Maximum="160" Value="60" Width="110" VerticalAlignment="Center"
                                        ValueChanged="PenseelSlider_ValueChanged" />
                                <CheckBox x:Name="GumBox" Content="Gum" Margin="12,0,0,0" VerticalAlignment="Center"
                                          Checked="GumBox_Changed" Unchecked="GumBox_Changed"
                                          Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSizeSmall}" />
                                <Button Content="Wis gebied" Click="WisGebied_Click" Margin="12,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
                            </StackPanel>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Right">
                <Button x:Name="OpslaanButton" Content="Opslaan als…" Click="OpslaanButton_Click" IsEnabled="False"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button x:Name="AnimeerButton" Content="Animeer dit beeld" Click="AnimeerButton_Click" IsEnabled="False"
                        Margin="0,0,10,0" Style="{DynamicResource AccentButtonStyle}" />
                <Button x:Name="NaarTekstButton" Content="Laat dit beeld beschrijven" Click="NaarTekstButton_Click" IsEnabled="False"
                        Margin="10,0,0,0" Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

        <!-- Galerij: eerder gemaakte beelden, nieuwste links. -->
        <ListBox Grid.Row="2" Grid.ColumnSpan="3" x:Name="Galerij" Margin="0,16,0,0" Height="116"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectionChanged="Galerij_SelectionChanged" KeyDown="Galerij_KeyDown">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>

</UserControl>
