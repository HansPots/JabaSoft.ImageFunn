<Window x:Class="ImageFunn.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:apps="clr-namespace:ImageFunn.App.Paginas"
        Title="ImageFunn" Height="1080" Width="1920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource BackgroundBrush}">

    <!-- Geen titelbalk van Windows: de header heeft zijn eigen
         vensterknopjes (Controls/WindowControlButtons) en zou er anders
         twee boven elkaar krijgen. Zelfde opzet als Jabasoft en AI Studio -
         zie hun eigen MainWindow.xaml voor de volledige toelichting op
         WindowChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- De paginaschil van deze app (Paginas/Hoofdscherm.xaml) - een Basis
         met daarin onze eigen Hoofdbalk en Statusbalk. Alles wat die schil
         gebruikt staat in DIT project (Controls/, Regios/, Paginas/):
         ImageFunn deelt geen componenten met Jabasoft of AI Studio, zodat
         hier aangepast kan worden zonder dat de andere applicaties
         meeveranderen. Venstermaat 1920x1080, de familie-standaard.

         Menu, Inhoud en Actie worden in code-behind gevuld (zie
         MainWindow.xaml.cs). Ze kunnen hier niet met x:Name in XAML staan -
         een x:Name'd element DAT als property-waarde aan Hoofdscherm wordt
         meegegeven botst met diens eigen naam-scope (MC3093). Vandaar ook
         geen inhoud tussen deze tags. -->
    <apps:Hoofdscherm x:Name="AppShell" />
</Window>
